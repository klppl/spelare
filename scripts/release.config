# Settings for scripts/release.sh. Nothing here is secret.

# Apple Developer team that owns the "Developer ID Application" certificate.
TEAM_ID=PGX5N2V7WQ

# notarytool keychain profile, created once with:
#   xcrun notarytool store-credentials spelare-notary --apple-id <you> --team-id PGX5N2V7WQ
NOTARY_PROFILE=spelare-notary

# GitHub repo that hosts the DMGs and appcast.xml. It must be public, or
# Sparkle and users can't download anything from it.
RELEASES_REPO=klppl/spelare

# Name used for the DMG file and its volume.
DMG_NAME=Spelare

# Public half of the Sparkle EdDSA key. Print it with:
#   build/SourcePackages/artifacts/sparkle/Sparkle/bin/generate_keys -p
SPARKLE_PUBLIC_ED_KEY=
